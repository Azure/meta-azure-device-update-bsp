[Unit]
Description=Setup ADU Swap File for Delta Updates
Documentation=man:adu-swap(8)
After=adu.mount
Wants=adu.mount
Before=deviceupdate-agent.service
ConditionPathIsMountPoint=/adu

[Service]
Type=oneshot
ExecStart=/usr/sbin/adu-setup-swap
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
