# U-Boot environment configuration for QEMU aarch64
# QEMU virt exposes pflash as single MTD device (128MB combined)
# U-Boot env at CONFIG_ENV_ADDR=0x4000000 (64MB offset = start of pflash1)
# Matches: CONFIG_ENV_SIZE=0x4000, CONFIG_ENV_SECT_SIZE=0x40000
# Format: Device name   Device offset   Env. size   Erase size
/dev/mtd0               0x4000000       0x4000      0x40000
