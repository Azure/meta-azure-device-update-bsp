# Machine configuration for i.MX8ULP LPDDR4 EVK with ADU support
MACHINE ?= "imx8ulp-lpddr4-evk"
DISTRO ?= "poky"

# Use systemd
INIT_MANAGER = "systemd"
DISTRO_FEATURES:append = " systemd"
VIRTUAL-RUNTIME_init_manager = "systemd"
VIRTUAL-RUNTIME_initscripts = "systemd-compat-units"

# Accept NXP EULA
ACCEPT_FSL_EULA = "1"

# WIC image configuration
WKS_FILE = "imx8ulp-adu-ab.wks.in"
IMAGE_FSTYPES = "wic wic.bmap"

# Kernel config
KERNEL_IMAGETYPE = "Image"

# Boot partition contents for WIC bootimg-partition
IMAGE_BOOT_FILES = "Image freescale/imx8ulp-evk.dtb boot.scr"

# Serial console
SERIAL_CONSOLES = "115200;ttyLP1"

# ADU configuration
ADU_MANUFACTURER = "Contoso"
ADU_MODEL = "i.MX8ULP-EVK"

# SWUpdate
IMAGE_INSTALL:append = " swupdate"

# Ensure U-Boot tools (fw_printenv/fw_setenv) are included
IMAGE_INSTALL:append = " libubootenv-bin"

# Include ADU board config
IMAGE_INSTALL:append = " adu-board-config"

# Disk/storage
IMAGE_ROOTFS_EXTRA_SPACE = "262144"

# Parallel build settings
BB_NUMBER_THREADS ?= "14"
PARALLEL_MAKE ?= "-j 14"

# Download/sstate directories
DL_DIR ?= "${TOPDIR}/downloads"
SSTATE_DIR ?= "${TOPDIR}/sstate-cache"
