# WIC layout for QEMU aarch64 A/B update image
# Partition layout:
#   1: boot    (FAT16) - kernel, boot.scr, uboot.env
#   2: rootA   (ext4)  - primary rootfs
#   3: rootB   (ext4)  - secondary rootfs (update target)
#   4: data    (ext4)  - persistent ADU data (/adu)

part /boot --source bootimg-partition --ondisk vda --fstype=vfat --label boot --active --align 4096 --size 100M
part / --source rootfs --ondisk vda --fstype=ext4 --label rootA --align 4096 --size 1500M
part --ondisk vda --fstype=ext4 --label rootB --align 4096 --size 1500M
part /adu --ondisk vda --fstype=ext4 --label adu --align 4096 --size 500M --fsoptions "defaults,noatime"

bootloader --ptable gpt
