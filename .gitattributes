# Force LF line endings on all text files. CRLF in shell scripts or systemd
# unit files makes them un-executable on the target (kernel reads
# "#!/bin/bash\r" and fails ENOENT looking for an interpreter named "bash\r").
* text=auto eol=lf
*.sh text eol=lf
*.service text eol=lf
*.mount text eol=lf
*.socket text eol=lf
*.target text eol=lf
*.bb text eol=lf
*.bbappend text eol=lf
*.inc text eol=lf
*.conf text eol=lf
*.cfg text eol=lf